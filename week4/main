package week4;

import java.util.Scanner;

public class main {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int menu, pinCode;
        String accountNo;

        accountNo = sc.nextLine();
        pinCode = sc.nextInt();

        BankAccount account = new BankAccount(accountNo," ",0.0, pinCode);
        ADM adm = new ADM(account);

        if(adm.checkAccount(accountNo, pinCode)) {
            
            do{
                System.out.println("=========== main menu ===========");
                System.out.println("1 แสดงข้อมุลบัญชี");
                System.out.println("2 ฝากเงิน");
                System.out.println("3 ถอนเงิน");
                System.out.println("4 เช็กคงเหลือ");
                System.out.println("0 ออกจากระบบ");
                System.out.println("เลือกเมนู: ");

                menu = sc.nextInt();

                if (menu == 1) {
                    adm.showInfoamation();
                }
                else if(menu == 2) {
                    System.out.println("จำนวนที่ฝากเงิน :");
                    double amount = sc.nextDouble();
                    adm.deposit(amount);
                }
                else if(menu == 3) {
                    System.out.println("จำนวนที่ถอนเงิน :");
                    double amount = sc.nextDouble();
                    adm.withdraw(amount);
                }
                else if(menu == 4) {
                    System.out.println("เช็กยอดเงินคงเหลือ");
                    adm.checkBalance();
                }
                else if(menu == 0) {
                    System.out.println("ออกจากระบบ");
                }
                else {
                    System.out.println("เลือกเมนูไม่ถูกต้อง");
                }
            } while (menu != 0);
            sc.close(); 
        } else { 
            System.out.println("ชื่อบัญชีหรือรหัสผ่านไม่ถูกต้อง");
        }
    }

}
